# Copy this file to .env and fill in at least one key. NEVER commit .env.
LLM_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash        # check ai.google.dev/gemini-api/docs/models for current names

# GitHub Issues tracker (fine-grained token: only the tracker repo, Issues read+write)
GITHUB_TOKEN=
GITHUB_REPO=yourname/meeting-tasks

# Gmail sender (needs 2-Step Verification + App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Real emails for the sample people (so demo emails reach you)
PEOPLE_EMAILS=Priya=you@example.com,Rahul=friend@example.com,Amit=you@example.com,Neha=friend@example.com
